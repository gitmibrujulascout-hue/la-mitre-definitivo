{
  "name": "VentaActividad",
  "type": "object",
  "properties": {
    "actividad_id": {
      "type": "string",
      "description": "ID de la actividad econ\u00f3mica"
    },
    "actividad_nombre": {
      "type": "string",
      "description": "Nombre de la actividad"
    },
    "beneficiario_id": {
      "type": "string",
      "description": "ID del beneficiario vendedor"
    },
    "beneficiario_nombre": {
      "type": "string",
      "description": "Nombre del beneficiario"
    },
    "producto_id": {
      "type": "string",
      "description": "ID del producto/promo vendido"
    },
    "producto_nombre": {
      "type": "string",
      "description": "Nombre del producto/promo al momento de la venta"
    },
    "precio_unitario_aplicado": {
      "type": "number",
      "description": "Precio de venta aplicado en esta venta (snapshot del precio del producto)"
    },
    "es_promo": {
      "type": "boolean",
      "default": false,
      "description": "Si esta venta corresponde a una promo por cantidad"
    },
    "cantidad_promo": {
      "type": "number",
      "description": "Cantidad de unidades f\u00edsicas incluidas en la promo (si aplica)"
    },
    "cantidad_vendida": {
      "type": "number",
      "description": "Cantidad de unidades (o cantidad de promos) vendidas por este beneficiario"
    },
    "monto_recaudado": {
      "type": "number",
      "description": "Monto total recaudado por este beneficiario en esta venta"
    },
    "credito_beneficiario": {
      "type": "number",
      "description": "Cr\u00e9dito que se acredita al beneficiario"
    },
    "credito_grupo": {
      "type": "number",
      "description": "Monto que va al grupo"
    },
    "comprador_nombre": {
      "type": "string",
      "description": "Nombre de la persona externa que compr\u00f3 (quien retira el pedido)"
    },
    "entregado": {
      "type": "boolean",
      "default": false,
      "description": "Si el pedido ya fue entregado al comprador"
    },
    "fecha_entrega": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se realiz\u00f3 la entrega"
    },
    "estado_rendicion": {
      "type": "string",
      "enum": [
        "Sin rendir",
        "Parcial",
        "Rendido"
      ],
      "default": "Sin rendir",
      "description": "Estado de la rendici\u00f3n del dinero por parte del vendedor"
    },
    "monto_rendido": {
      "type": "number",
      "description": "Monto efectivamente rendido por el vendedor (puede ser parcial)"
    },
    "fecha_rendicion": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se realiz\u00f3 la rendici\u00f3n (total o parcial)"
    },
    "acreditado": {
      "type": "boolean",
      "default": false,
      "description": "Si ya se acredit\u00f3 el cr\u00e9dito al beneficiario"
    },
    "observaciones": {
      "type": "string"
    }
  },
  "required": [
    "actividad_id",
    "beneficiario_id",
    "cantidad_vendida"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}