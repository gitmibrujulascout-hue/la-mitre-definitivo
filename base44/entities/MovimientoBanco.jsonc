{
  "name": "MovimientoBanco",
  "type": "object",
  "properties": {
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del movimiento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Ingreso",
        "Egreso"
      ],
      "description": "Tipo de movimiento"
    },
    "concepto": {
      "type": "string",
      "description": "Descripci\u00f3n del movimiento"
    },
    "monto": {
      "type": "number",
      "description": "Monto del movimiento"
    },
    "cuenta": {
      "type": "string",
      "enum": [
        "Caja",
        "Banco",
        "Caja exclusiva"
      ],
      "default": "Caja",
      "description": "A qu\u00e9 fondo pertenece este movimiento. 'Caja exclusiva' es el fondo separado de la tienda."
    },
    "origen": {
      "type": "string",
      "enum": [
        "Manual",
        "Pago cuota",
        "Pago campamento",
        "Gasto",
        "Cr\u00e9dito",
        "Afiliaci\u00f3n"
      ],
      "description": "Origen del movimiento"
    },
    "referencia_id": {
      "type": "string",
      "description": "ID de referencia (pago, gasto, venta tienda, etc.)"
    },
    "saldo_resultante": {
      "type": "number",
      "description": "Saldo en banco despu\u00e9s del movimiento"
    },
    "observaciones": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "fecha",
    "tipo",
    "concepto",
    "monto"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}