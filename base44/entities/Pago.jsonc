{
  "name": "Pago",
  "type": "object",
  "properties": {
    "beneficiario_id": {
      "type": "string",
      "description": "ID del beneficiario"
    },
    "beneficiario_nombre": {
      "type": "string",
      "description": "Nombre del beneficiario (para f\u00e1cil visualizaci\u00f3n)"
    },
    "mes": {
      "type": "string",
      "enum": [
        "Enero",
        "Febrero",
        "Marzo",
        "Abril",
        "Mayo",
        "Junio",
        "Julio",
        "Agosto",
        "Septiembre",
        "Octubre",
        "Noviembre",
        "Diciembre"
      ],
      "description": "Mes al que corresponde el pago"
    },
    "anio": {
      "type": "number",
      "description": "A\u00f1o al que corresponde el pago"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Transferencia"
      ],
      "description": "Forma de pago"
    },
    "monto": {
      "type": "number",
      "description": "Monto del pago"
    },
    "fecha_pago": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se realiz\u00f3 el pago"
    },
    "observaciones": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "beneficiario_id",
    "mes",
    "anio",
    "forma_pago",
    "monto"
  ]
}