{
  "name": "Pago",
  "type": "object",
  "properties": {
    "beneficiario_id": {
      "type": "string",
      "description": "ID del beneficiario"
    },
    "beneficiario_nombre": {
      "type": "string",
      "description": "Nombre del beneficiario (para f\u00e1cil visualizaci\u00f3n)"
    },
    "tipo_pago": {
      "type": "string",
      "enum": [
        "Cuota",
        "Campamento"
      ],
      "default": "Cuota",
      "description": "Tipo de pago: cuota mensual o campamento"
    },
    "meses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Meses abonados (para pagos de cuota, puede ser m\u00faltiple)"
    },
    "mes": {
      "type": "string",
      "enum": [
        "Enero",
        "Febrero",
        "Marzo",
        "Abril",
        "Mayo",
        "Junio",
        "Julio",
        "Agosto",
        "Septiembre",
        "Octubre",
        "Noviembre",
        "Diciembre"
      ],
      "description": "Mes principal (compatibilidad)"
    },
    "anio": {
      "type": "number",
      "description": "A\u00f1o al que corresponde el pago"
    },
    "campamento_id": {
      "type": "string",
      "description": "ID del campamento (si tipo_pago es Campamento)"
    },
    "campamento_nombre": {
      "type": "string",
      "description": "Nombre del campamento"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Transferencia",
        "Cr\u00e9dito actividad"
      ],
      "description": "Forma de pago"
    },
    "destino": {
      "type": "string",
      "enum": [
        "Caja",
        "Banco"
      ],
      "default": "Caja",
      "description": "Destino del dinero: Caja (efectivo) o Banco (transferencia)"
    },
    "monto": {
      "type": "number",
      "description": "Monto del pago"
    },
    "fecha_pago": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se realiz\u00f3 el pago"
    },
    "observaciones": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "beneficiario_id",
    "anio",
    "forma_pago",
    "monto"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.beneficiario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}