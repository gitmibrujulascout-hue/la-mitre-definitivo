{
  "name": "Beneficiario",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre completo"
    },
    "dni": {
      "type": "string",
      "description": "DNI"
    },
    "telefono_contacto": {
      "type": "string",
      "description": "Tel\u00e9fono / WhatsApp principal"
    },
    "telefono_contacto_2": {
      "type": "string",
      "description": "Tel\u00e9fono / WhatsApp secundario (ej: mam\u00e1, pap\u00e1)"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento"
    },
    "funcion": {
      "type": "string",
      "description": "Funci\u00f3n dentro del grupo"
    },
    "categoria": {
      "type": "string",
      "description": "Categor\u00eda seg\u00fan el sistema scout"
    },
    "zona": {
      "type": "string",
      "description": "Zona"
    },
    "distrito": {
      "type": "string",
      "description": "Distrito"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo del organismo"
    },
    "organismo": {
      "type": "string",
      "description": "Organismo"
    },
    "religion": {
      "type": "string",
      "description": "Religi\u00f3n"
    },
    "religion_descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n de religi\u00f3n"
    },
    "estado_panuelo": {
      "type": "string",
      "enum": [
        "",
        "Promesa",
        "Investidura",
        "Paturuz\u00fa"
      ],
      "default": "",
      "description": "Estado del pa\u00f1uelo: Promesa, Investidura o Paturuz\u00fa (equipo especial de adultos)"
    },
    "rama": {
      "type": "string",
      "enum": [
        "Lobatos",
        "Tropa",
        "KM",
        "Rovers",
        "Voluntario",
        "Educador"
      ],
      "description": "Rama scout seg\u00fan edad o rol"
    },
    "rama_educador": {
      "type": "string",
      "enum": [
        "Lobatos",
        "Tropa",
        "KM",
        "Rovers"
      ],
      "description": "Rama en la que el adulto/educador trabaja como responsable."
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Beneficiario",
        "Voluntario"
      ],
      "default": "Beneficiario",
      "description": "Tipo: Beneficiario (menor, abona cuota) o Voluntario (adulto, no abona)"
    },
    "tipo_afiliacion": {
      "type": "string",
      "enum": [
        "General",
        "Acompa\u00f1ante"
      ],
      "default": "General",
      "description": "Tipo de afiliaci\u00f3n que abona: General (monto_general) o Acompa\u00f1ante (monto_acompanante). Se asigna manualmente por persona."
    },
    "becado": {
      "type": "boolean",
      "default": false,
      "description": "Si est\u00e1 becado (no paga cuota)"
    },
    "grupo_familiar": {
      "type": "string",
      "description": "Identificador del grupo familiar"
    },
    "email_contacto": {
      "type": "string",
      "description": "Email de contacto"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si est\u00e1 activo"
    },
    "fecha_baja": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que dej\u00f3 de asistir (baja temporal)."
    },
    "fecha_reingreso": {
      "type": "string",
      "format": "date",
      "description": "Fecha de reingreso tras una baja temporal."
    },
    "fecha_primer_afiliacion": {
      "type": "string",
      "format": "date",
      "description": "Fecha de primera afiliaci\u00f3n a Scouts."
    },
    "provincia": {
      "type": "string",
      "description": "Provincia"
    },
    "localidad": {
      "type": "string",
      "description": "Localidad / ciudad"
    },
    "calle": {
      "type": "string",
      "description": "Direcci\u00f3n (calle y n\u00famero)"
    },
    "codigo_postal": {
      "type": "string",
      "description": "C\u00f3digo postal"
    },
    "nacionalidad": {
      "type": "string",
      "description": "Nacionalidad"
    },
    "sexo": {
      "type": "string",
      "description": "Sexo"
    },
    "estado_civil": {
      "type": "string",
      "description": "Estado civil"
    },
    "estudios": {
      "type": "string",
      "description": "Nivel de estudios"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo obtenido"
    },
    "discapacidad": {
      "type": "string",
      "description": "Indicador de discapacidad / CUD"
    },
    "detalle_discapacidad": {
      "type": "string",
      "description": "Descripci\u00f3n de la discapacidad"
    },
    "alergias": {
      "type": "string",
      "description": "Alergias conocidas (alimentos, medicamentos, etc.)"
    },
    "condicion_medica": {
      "type": "string",
      "description": "Condiciones m\u00e9dicas o enfermedades cr\u00f3nicas relevantes"
    },
    "medicacion_habitual": {
      "type": "string",
      "description": "Medicaci\u00f3n habitual que toma"
    },
    "grupo_sanguineo": {
      "type": "string",
      "description": "Grupo sangu\u00edneo (ej: A, B, AB, O)"
    },
    "factor_rh": {
      "type": "string",
      "description": "Factor RH (Positivo o Negativo)"
    },
    "peso_kg": {
      "type": "number",
      "description": "Peso en kilogramos"
    },
    "talla_m": {
      "type": "number",
      "description": "Talla / altura en metros"
    },
    "regimen_dietario": {
      "type": "string",
      "description": "R\u00e9gimen dietario especial (ej: vegetariano, cel\u00edaco, etc.)"
    },
    "anticoagulacion": {
      "type": "string",
      "description": "Si est\u00e1 anticoagulado y con qu\u00e9 droga"
    },
    "salud_mental": {
      "type": "string",
      "description": "Diagn\u00f3stico o tratamiento de salud mental relevante (ej: ansiedad, fobia, etc.)"
    },
    "obra_social": {
      "type": "string",
      "description": "Obra social / prepaga"
    },
    "numero_obra_social": {
      "type": "string",
      "description": "N\u00famero de afiliado obra social"
    },
    "contacto_emergencia_nombre": {
      "type": "string",
      "description": "Nombre del contacto de emergencia"
    },
    "contacto_emergencia_telefono": {
      "type": "string",
      "description": "Tel\u00e9fono del contacto de emergencia"
    },
    "contacto_emergencia_relacion": {
      "type": "string",
      "description": "Relaci\u00f3n con el contacto de emergencia"
    },
    "observaciones_salud": {
      "type": "string",
      "description": "Observaciones de salud adicionales"
    }
  },
  "required": [
    "nombre"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}