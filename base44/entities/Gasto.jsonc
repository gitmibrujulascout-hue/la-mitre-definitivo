{
  "name": "Gasto",
  "type": "object",
  "properties": {
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n del gasto"
    },
    "monto": {
      "type": "number",
      "description": "Monto del gasto"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del gasto"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Materiales",
        "Alimentos",
        "Transporte",
        "Servicios",
        "Mantenimiento",
        "Campamento",
        "Otro"
      ],
      "description": "Categor\u00eda del gasto"
    },
    "proveedor": {
      "type": "string",
      "description": "Proveedor o comercio"
    },
    "numero_factura": {
      "type": "string",
      "description": "N\u00famero de factura o recibo"
    },
    "archivo_url": {
      "type": "string",
      "description": "URL del archivo adjunto (PDF o imagen)"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Transferencia"
      ],
      "description": "Forma de pago"
    },
    "destino": {
      "type": "string",
      "enum": [
        "Caja",
        "Banco"
      ],
      "description": "Destino del dinero (derivado de forma_pago)"
    },
    "campamento_id": {
      "type": "string",
      "description": "ID del campamento asociado (opcional)"
    },
    "campamento_nombre": {
      "type": "string",
      "description": "Nombre del campamento asociado"
    },
    "actividad_id": {
      "type": "string",
      "description": "ID de la actividad econ\u00f3mica asociada (opcional)"
    },
    "actividad_nombre": {
      "type": "string",
      "description": "Nombre de la actividad econ\u00f3mica asociada"
    },
    "observaciones": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "descripcion",
    "monto",
    "fecha"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}