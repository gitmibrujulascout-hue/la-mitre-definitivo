{
  "name": "Campamento",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre del campamento"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin"
    },
    "costo_por_persona": {
      "type": "number",
      "description": "Costo por persona del campamento (beneficiarios)"
    },
    "costo_adultos": {
      "type": "number",
      "description": "Costo por persona adulta (si adultos_pagan es true)"
    },
    "adultos_pagan": {
      "type": "boolean",
      "default": false,
      "description": "Si los adultos/voluntarios deben abonar el campamento"
    },
    "es_privado": {
      "type": "boolean",
      "default": false,
      "description": "Si es un campamento privado por rama: los movimientos de dinero se gestionan dentro del campamento y no impactan en la caja general del grupo"
    },
    "costos_individuales": {
      "type": "object",
      "description": "Costos personalizados por persona: { 'beneficiario_id': monto }. Anula el costo_por_persona / costo_adultos."
    },
    "presupuesto": {
      "type": "object",
      "description": "Datos del presupuesto del campamento: { comida_por_persona_dia, items: { transporte: monto, ... }, splits: { transporte: bool, ... } }"
    },
    "ramas_participantes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ramas que participan"
    },
    "beneficiarios_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de beneficiarios que asisten"
    },
    "adultos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de adultos/voluntarios que asisten"
    },
    "autorizaciones_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de beneficiarios menores de 18 a\u00f1os que entregaron la autorizaci\u00f3n familiar"
    },
    "confirmaciones_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de personas (beneficiarios y adultos) que confirmaron su asistencia al campamento"
    },
    "autorizacion_activa": {
      "type": "boolean",
      "default": false,
      "description": "Si el formulario de autorizaci\u00f3n est\u00e1 disponible para que las familias lo descarguen"
    },
    "autorizacion_texto": {
      "type": "string",
      "description": "Texto general de la autorizaci\u00f3n (condiciones, declaraci\u00f3n legal) que el admin pre-completa; las familias descargan el formulario con este texto y los datos del menor ya cargados."
    },
    "circular_url": {
      "type": "string",
      "description": "URL del PDF de la circular / info del campamento que el admin adjunta. Se descarga tal cual (sin edici\u00f3n) por las familias de los asistentes."
    },
    "ubicacion": {
      "type": "string",
      "description": "Ubicaci\u00f3n del campamento"
    },
    "observaciones": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "nombre",
    "fecha_inicio",
    "costo_por_persona"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}