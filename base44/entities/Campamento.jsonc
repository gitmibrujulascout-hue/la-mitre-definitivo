{
  "name": "Campamento",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre del campamento"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin"
    },
    "costo_por_persona": {
      "type": "number",
      "description": "Costo por persona del campamento (beneficiarios)"
    },
    "costo_adultos": {
      "type": "number",
      "description": "Costo por persona adulta (si adultos_pagan es true)"
    },
    "adultos_pagan": {
      "type": "boolean",
      "default": false,
      "description": "Si los adultos/voluntarios deben abonar el campamento"
    },
    "es_privado": {
      "type": "boolean",
      "default": false,
      "description": "Si es un campamento privado por rama: los movimientos de dinero se gestionan dentro del campamento y no impactan en la caja general del grupo"
    },
    "ramas_participantes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ramas que participan"
    },
    "beneficiarios_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de beneficiarios que asisten"
    },
    "adultos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de adultos/voluntarios que asisten"
    },
    "autorizaciones_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de beneficiarios menores de 18 a\u00f1os que entregaron la autorizaci\u00f3n familiar"
    },
    "ubicacion": {
      "type": "string",
      "description": "Ubicaci\u00f3n del campamento"
    },
    "observaciones": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "nombre",
    "fecha_inicio",
    "costo_por_persona"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}