{
  "name": "ConfigCuota",
  "type": "object",
  "properties": {
    "mes": {
      "type": "string",
      "enum": [
        "Enero",
        "Febrero",
        "Marzo",
        "Abril",
        "Mayo",
        "Junio",
        "Julio",
        "Agosto",
        "Septiembre",
        "Octubre",
        "Noviembre",
        "Diciembre"
      ],
      "description": "Mes de la configuraci\u00f3n de cuota"
    },
    "anio": {
      "type": "number",
      "description": "A\u00f1o de la configuraci\u00f3n"
    },
    "monto_efectivo": {
      "type": "number",
      "description": "Monto de la cuota en efectivo"
    },
    "monto_transferencia": {
      "type": "number",
      "description": "Monto de la cuota por transferencia"
    },
    "es_bonificado_credito": {
      "type": "boolean",
      "default": false,
      "description": "Si este mes divide la cuota en pago + cr\u00e9dito (ej: Julio). El cr\u00e9dito se genera autom\u00e1ticamente al pagar el mes, estando al d\u00eda con los meses anteriores."
    },
    "monto_credito": {
      "type": "number",
      "description": "Monto que se acredita como cr\u00e9dito a cada beneficiario (si es_bonificado_credito es true)"
    },
    "observaciones": {
      "type": "string",
      "description": "Notas adicionales (ej: aumento aplicado)"
    }
  },
  "required": [
    "mes",
    "anio",
    "monto_efectivo"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}