{
  "name": "VentaTienda",
  "type": "object",
  "properties": {
    "producto_id": {
      "type": "string",
      "description": "ID del producto vendido"
    },
    "producto_nombre": {
      "type": "string",
      "description": "Nombre del producto (snapshot)"
    },
    "beneficiario_id": {
      "type": "string",
      "description": "ID del beneficiario comprador (opcional)"
    },
    "beneficiario_nombre": {
      "type": "string",
      "description": "Nombre del beneficiario comprador"
    },
    "comprador_nombre": {
      "type": "string",
      "description": "Nombre del comprador (si no es beneficiario)"
    },
    "talle": {
      "type": "string",
      "description": "Talle vendido (si aplica)"
    },
    "cantidad": {
      "type": "number",
      "default": 1,
      "description": "Cantidad vendida"
    },
    "precio_unitario": {
      "type": "number",
      "description": "Precio unitario al momento de la venta"
    },
    "monto_total": {
      "type": "number",
      "description": "Monto total de la venta"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la venta"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Transferencia"
      ],
      "description": "Forma de pago"
    },
    "destino": {
      "type": "string",
      "enum": [
        "Caja",
        "Banco"
      ],
      "default": "Caja",
      "description": "Destino del dinero"
    },
    "observaciones": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "producto_id",
    "producto_nombre",
    "cantidad",
    "precio_unitario",
    "monto_total",
    "fecha",
    "forma_pago"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}